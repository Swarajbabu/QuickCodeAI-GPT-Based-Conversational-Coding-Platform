# QuickCodeAI-GPT Frontend Environment Configuration

# If deploying frontend and backend together (Unified deployment on Render/Railway/Fly.io):
# Leave VITE_API_URL empty or unset. Requests will automatically use relative paths (/api/...)
# VITE_API_URL=

# If deploying frontend separately (e.g. on Vercel or Netlify) pointing to a remote backend:
# Set this to your backend server's public URL (without trailing slash):
# VITE_API_URL=https://your-backend-api.onrender.com
