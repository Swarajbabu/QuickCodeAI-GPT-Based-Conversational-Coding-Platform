# AI API Key (Groq or OpenAI - at least one required)
GROQ_API_KEY=gsk_your_groq_api_key_here
# OPENAI_API_KEY=sk-your_openai_api_key_here

# Server Port (assigned automatically by cloud hosts like Render/Railway/Heroku)
PORT=8080

# Environment Mode ("production" for deployed apps, "development" for local)
NODE_ENV=production

# AI Model to use (Groq default: llama-3.3-70b-versatile or qwen/qwen3.8-27b; OpenAI default: gpt-4o-mini)
AI_MODEL=qwen/qwen3.8-27b

# Allowed Frontend URL for CORS (Leave empty for unified deployment; specify domain if frontend is on Vercel/Netlify)
# FRONTEND_URL=https://your-frontend.vercel.app
